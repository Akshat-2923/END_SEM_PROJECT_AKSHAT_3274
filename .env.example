# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register a free account at: https://dataspace.copernicus.eu/
# Method 1: Standard Account (Used for OData single-band B03/B08 node downloads)
CDSE_USERNAME=your_copernicus_username_or_email
CDSE_PASSWORD=your_copernicus_password

# Optional Method 2: Direct Bearer Access Token (if generated externally via cURL or Keycloak)
# CDSE_ACCESS_TOKEN=your_jwt_access_token_here

# Optional Method 3: CDSE OAuth Client (for Sentinel Hub Process API spatial subsetting)
# Generate under Dashboard -> User Settings -> OAuth Clients
# CDSE_OAUTH_CLIENT_ID=your_oauth_client_id
# CDSE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Analysis Configuration Defaults
# Study Area: Gomti River segment in Lucknow, Uttar Pradesh, India
# Bounding Box: [min_lon, min_lat, max_lon, max_lat] (WGS84 EPSG:4326)
DHARASCOPE_BBOX=80.88,26.80,81.00,26.90

# NDWI Classification Threshold (Default: 0.0)
# Values > threshold are classified as water. Note: NDWI must be calibrated locally for specific seasons and turbidity.
DHARASCOPE_NDWI_THRESHOLD=0.0

# Database Configuration (PostgreSQL 16 + PostGIS 3.6 - Local or Azure Flexible Server)
# Standard local application connection string:
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/dharascope

# Isolated database connection string for automated test suites:
TEST_DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/dharascope_test

# SSL Configuration for Cloud Databases (e.g. Azure Database for PostgreSQL Flexible Server)
# Azure Flexible Server enforces SSL by default: set DB_SSL_MODE=require (or verify-ca / verify-full)
# For local development without SSL, leave empty or unset.
DB_SSL_MODE=require

# Optional path to Root CA certificate bundle for verify-ca or verify-full (e.g. DigiCertGlobalRootCA.crt.pem)
# DB_SSL_ROOT_CERT=/path/to/DigiCertGlobalRootCA.crt.pem

# SQLAlchemy Connection Pool Configuration
# Recommended for Azure B1ms/B2s burstable instances to manage connection limits
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Supabase Authentication & JWT Validation
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: Supabase JWKS URL for asymmetric RS256/ES256 verification
# Defaults to: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Target JWT Audience (Default: authenticated)
SUPABASE_AUDIENCE=authenticated



