# ==============================================================================
# DharaScope Backend Environment Configuration Template
# Copy to .env for local development (never commit real .env files or secrets).
# ==============================================================================

# Application Runtime Environment ('development' or 'production')
ENVIRONMENT=development

# Deployed Frontend Origin for Backend CORS Allowlist (required in production)
# Example: https://dharascope-frontend.onrender.com
FRONTEND_URL=

# Optional comma-separated additional allowed CORS origins
# CORS_ORIGINS=https://preview.dharascope.example.com

# ------------------------------------------------------------------------------
# Database Configuration (Supabase Managed PostgreSQL + PostGIS / Local Postgres)
# ------------------------------------------------------------------------------
# Local default example:
#   postgresql+psycopg2://postgres@localhost:5432/dharascope
# Supabase Session Pooler (IPv4-compatible, recommended for Render Web Services):
#   postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Isolated database connection string for automated test suites (local testing only)
TEST_DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/dharascope_test

# SSL Configuration: automatically defaults to 'require' for cloud PostgreSQL hosts
# (.supabase.co, .pooler.supabase.com, .database.azure.com). Leave empty for non-SSL local dev.
# DB_SSL_MODE=require
# DB_SSL_ROOT_CERT=

# SQLAlchemy Connection Pool Sizing (tuned for Supabase Session Pooler limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# ------------------------------------------------------------------------------
# Supabase Authentication & Storage
# ------------------------------------------------------------------------------
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Public Anonymous Key (used by frontend / client SDK integrations; never grant elevated backend privileges)
SUPABASE_ANON_KEY=
# Server-side Service Role Key (STRICTLY backend-only; never expose to frontend or client responses)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=
# Optional JWKS URL for asymmetric RS256/ES256 verification (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=
SUPABASE_AUDIENCE=authenticated

# Supabase Object Storage for Analysis Artifacts (true recommended for Render Web Service)
SUPABASE_STORAGE_ENABLED=false

# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) Satellite Retrieval (Optional for Real S2 OData)
# ------------------------------------------------------------------------------
# Register at: https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=
# Optional direct token or Sentinel Hub OAuth client credentials:
# CDSE_ACCESS_TOKEN=
# CDSE_OAUTH_CLIENT_ID=
# CDSE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Geospatial Processing Defaults
# ------------------------------------------------------------------------------
# Study Area Bounding Box: [min_lon, min_lat, max_lon, max_lat] (WGS84 EPSG:4326)
DHARASCOPE_BBOX=80.88,26.80,81.00,26.90
DHARASCOPE_NDWI_THRESHOLD=0.0
DHARASCOPE_MIN_AOI_KM2=0.10
DHARASCOPE_MAX_AOI_KM2=100.00
DHARASCOPE_MAX_AOI_VERTICES=500
