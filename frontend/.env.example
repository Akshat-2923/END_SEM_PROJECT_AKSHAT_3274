# DharaScope Frontend Environment Configuration (Copy to frontend/.env for local dev)
# Note: Only VITE_* variables are exposed to the browser bundle. NEVER add service_role keys here!

# Backend API URL:
# - Local development (leave unset or empty to use Vite dev proxy /api -> localhost:8000, or set explicitly):
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
# - Production (Render Static Site): set in Render Dashboard to your backend Web Service URL:
#   VITE_API_BASE_URL=https://dharascope-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# Supabase Public Project Credentials (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
